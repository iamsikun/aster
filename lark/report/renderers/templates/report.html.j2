{%- macro depth_badge(depth) -%}
{%- set bg, fg = DEPTH_COLORS[depth] -%}
<span style="display:inline-block;padding:2px 8px;border-radius:10px;background-color:{{ bg }};color:{{ fg }};font-size:12px;font-weight:bold;">{{ DEPTH_LABELS[depth] }}</span>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ r.title }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f5;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:680px;background-color:#ffffff;color:#1f2937;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;border-radius:8px;">
<tr><td style="padding:20px 24px 8px 24px;">
  <h1 style="margin:0 0 8px 0;font-size:22px;color:#111827;">{{ r.title }}</h1>
  <p style="margin:0 0 8px 0;color:#1f2937;">{{ r.summary }}</p>
  {% if not r.items and r.quiet_day_reason %}
  <p style="margin:8px 0;padding:10px 12px;background-color:#f3f4f6;color:#374151;border-radius:6px;"><b>Quiet day.</b> {{ r.quiet_day_reason }}</p>
  {% endif %}
  {% for n in r.notes %}
  <p style="margin:6px 0;padding:8px 12px;background-color:#fef3c7;color:#78350f;border-radius:6px;font-size:13px;">&#9888; {{ n }}</p>
  {% endfor %}
</td></tr>
{% for it in r.items %}
{% set w = it.work %}
<tr><td style="padding:12px 24px;border-top:1px solid #e5e7eb;">
  <h2 style="margin:0 0 4px 0;font-size:18px;color:#111827;">{{ loop.index }}. {% if w.links %}<a href="{{ w.links[0].url }}" style="color:#1d4ed8;text-decoration:none;">{{ w.title }}</a>{% else %}{{ w.title }}{% endif %}</h2>
  <p style="margin:0 0 6px 0;font-size:13px;color:#4b5563;">{{ w.authors | join(", ") }}{% if w.venue %} &middot; {{ w.venue }}{% endif %}{% if STATUS_LABELS[w.status] %} &middot; {{ STATUS_LABELS[w.status] }}{% endif %}{% if w.released_date %} &middot; {{ w.released_date }}{% endif %}
  {% for l in w.links %} &middot; <a href="{{ l.url }}" style="color:#1d4ed8;">{{ l.label }}</a>{% endfor %}</p>
  <p style="margin:0 0 8px 0;font-size:13px;color:#374151;">{{ depth_badge(it.reading_depth) }}
  {% if it.sections_read %}<span style="color:#6b7280;"> read: {{ it.sections_read | sections_summary }}</span>{% endif %}
  &nbsp;<b>priority {{ it.priority }}</b>{% if it.profiles %} &middot; {{ it.profiles | join(", ") }}{% endif %}</p>
  {% if it.is_update_of %}
  <p style="margin:0 0 8px 0;font-size:13px;color:#92400e;"><i>Update since {{ it.is_update_of }}{% if it.update_note %}: {{ it.update_note }}{% endif %}</i></p>
  {% endif %}
  <p style="margin:0 0 8px 0;"><b>Why now:</b> {{ it.why_now }}</p>
  {% set c = it.contribution %}
  {% if c.question or c.obstacle or c.idea or c.main_result %}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px 0;font-size:14px;color:#1f2937;">
    {% for label, val in [("Question", c.question), ("Obstacle", c.obstacle), ("Idea", c.idea), ("Main result", c.main_result)] if val %}
    <tr><td valign="top" style="padding:2px 10px 2px 0;color:#6b7280;white-space:nowrap;">{{ label }}</td><td style="padding:2px 0;">{{ val }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
  {% for cl in it.claims %}
  <p style="margin:6px 0 2px 0;font-size:14px;"><span style="font-size:11px;font-weight:bold;text-transform:uppercase;color:{% if cl.kind == 'paper_result' %}#065f46{% else %}#9a3412{% endif %};">{{ CLAIM_KIND_LABELS[cl.kind] }}</span> {{ cl.text }}</p>
  {% for ev in cl.evidence %}
  <p style="margin:2px 0 4px 12px;padding:4px 10px;border-left:3px solid #d1d5db;font-size:13px;color:#4b5563;">&ldquo;{{ ev.quote }}&rdquo;{% if ev.location %} &mdash; {{ ev.location }}{% endif %}
  {% if ev.verified %}<span style="color:#047857;font-weight:bold;"> &#10003; verified</span>{% else %}<span style="color:#b45309;font-weight:bold;"> unverified</span>{% endif %}</p>
  {% endfor %}
  {% endfor %}
  {% if it.conditions %}
  <p style="margin:8px 0 4px 0;font-size:14px;"><b>Conditions:</b> {{ it.conditions | join("; ") }}</p>
  {% endif %}
  {% if it.connection %}
  <p style="margin:8px 0 4px 0;padding:8px 12px;background-color:#eff6ff;color:#1e3a8a;border-radius:6px;font-size:14px;"><b>Lark's inference</b> <span style="font-size:12px;">({{ it.connection.profile }})</span>: {{ it.connection.text }}</p>
  {% endif %}
  {% if it.analysis %}
  <p style="margin:8px 0 4px 0;font-size:14px;"><b>Analysis:</b> {{ it.analysis }}</p>
  {% endif %}
  {% if it.feedback_actions %}
  <p style="margin:10px 0 0 0;font-size:12px;color:#6b7280;">Feedback:
  {% for f in it.feedback_actions %}<a href="{{ f.url }}" style="color:#1d4ed8;">{{ f.label }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
  {% endif %}
</td></tr>
{% endfor %}
{% if r.themes %}
<tr><td style="padding:12px 24px;border-top:1px solid #e5e7eb;">
  <h2 style="margin:0 0 6px 0;font-size:18px;color:#111827;">Themes this week</h2>
  {% for t in r.themes %}
  <h3 style="margin:8px 0 2px 0;font-size:15px;color:#111827;">{{ t.title }}</h3>
  <p style="margin:0 0 6px 0;">{{ t.text }}</p>
  {% endfor %}
</td></tr>
{% endif %}
{% if r.also_noted %}
<tr><td style="padding:12px 24px;border-top:1px solid #e5e7eb;">
  <h2 style="margin:0 0 6px 0;font-size:16px;color:#111827;">Also noted</h2>
  <ul style="margin:0;padding-left:18px;font-size:14px;">
  {% for w in r.also_noted %}
    <li>{% if w.links %}<a href="{{ w.links[0].url }}" style="color:#1d4ed8;">{{ w.title }}</a>{% else %}{{ w.title }}{% endif %}{% if w.venue %} <span style="color:#6b7280;">({{ w.venue }})</span>{% endif %}</li>
  {% endfor %}
  </ul>
</td></tr>
{% endif %}
<tr><td style="padding:12px 24px 20px 24px;border-top:1px solid #e5e7eb;font-size:12px;color:#6b7280;">
  {% if flagged_sources %}
  <p style="margin:0 0 4px 0;color:#b91c1c;"><b>Source problems:</b> {% for s in flagged_sources %}{{ s.source }}: <b>{{ s.status }}</b>{% if s.note %} ({{ s.note }}){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</p>
  {% endif %}
  <p style="margin:0 0 4px 0;">Sources OK: {% for s in ok_sources %}{{ s.source }} ({{ s.n_records }}){% if not loop.last %}, {% endif %}{% endfor %}</p>
  <p style="margin:0 0 4px 0;">Collected {{ r.stats.collected }} &middot; new {{ r.stats.new_works }} &middot; screened {{ r.stats.screened }} &middot; read {{ r.stats.read }} &middot; analyzed {{ r.stats.analyzed }} &middot; backlog {{ r.stats.backlog }}</p>
  <p style="margin:0 0 4px 0;">Budget: ${{ "%.2f" | format(r.budget.cash_today_usd) }} today, ${{ "%.2f" | format(r.budget.cash_month_usd) }} of ${{ "%.2f" | format(r.budget.monthly_cap_usd) }} this month{% if r.budget.routes %} &middot; routes: {% for rt in r.budget.routes %}{{ rt.route }} {{ rt.calls_today }}{% if not rt.ok %} <span style="color:#b91c1c;">&#10007;</span>{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
  <p style="margin:0;">Report {{ r.report_id }} &middot; {{ r.generated_at }} &middot; contract v{{ r.schema_version }}</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
