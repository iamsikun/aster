# Copy to .env for local runs. In GitHub Actions these are repository secrets on lark-data.

# Where the private lark-data checkout lives
LARK_DATA_DIR=../lark-data
LARK_CONTACT_EMAIL=sikun@wustl.edu          # sent in User-Agent / Crossref polite pool

# Email delivery (Gmail SMTP with an app password)
LARK_SMTP_USER=you@gmail.com
LARK_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
LARK_EMAIL_TO=sikun@wustl.edu

# SSRN alerts are read over IMAP from the same Gmail account (label "ssrn")
LARK_IMAP_USER=you@gmail.com
LARK_IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Screener: Gemini API key (Google AI Pro developer credit)
GEMINI_API_KEY=

# Readers: subscription-backed CLIs
CLAUDE_CODE_OAUTH_TOKEN=                    # from `claude setup-token`; never set ANTHROPIC_API_KEY alongside
# Codex uses ~/.codex/auth.json created by `codex login` (CI restores it from CODEX_AUTH_JSON)

# Sources
OPENALEX_API_KEY=
GITHUB_TOKEN=                               # releases collector + feedback issue sync

# Optional channels
SLACK_WEBHOOK_URL=
NOTION_API_KEY=
NOTION_DATABASE_ID=

# OpenReview API v2 requires a (free) account
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
