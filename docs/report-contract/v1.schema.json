{
  "$defs": {
    "BudgetSummary": {
      "additionalProperties": false,
      "properties": {
        "cash_today_usd": {
          "default": 0.0,
          "title": "Cash Today Usd",
          "type": "number"
        },
        "cash_month_usd": {
          "default": 0.0,
          "title": "Cash Month Usd",
          "type": "number"
        },
        "monthly_cap_usd": {
          "default": 0.0,
          "title": "Monthly Cap Usd",
          "type": "number"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/RouteStatus"
          },
          "title": "Routes",
          "type": "array"
        }
      },
      "title": "BudgetSummary",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "paper_result",
            "author_interpretation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceAnchor"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "label": {
          "const": "lark_inference",
          "default": "lark_inference",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "text"
      ],
      "title": "Connection",
      "type": "object"
    },
    "Contribution": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "obstacle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obstacle"
        },
        "idea": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idea"
        },
        "main_result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Result"
        }
      },
      "title": "Contribution",
      "type": "object"
    },
    "EvidenceAnchor": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified"
        }
      },
      "required": [
        "quote"
      ],
      "title": "EvidenceAnchor",
      "type": "object"
    },
    "FeedbackAction": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "value": {
          "enum": [
            "useful",
            "peripheral",
            "known",
            "wrong_topic",
            "missed_key",
            "deep_read"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url",
        "value"
      ],
      "title": "FeedbackAction",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "Link",
      "type": "object"
    },
    "ReportItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "work": {
          "$ref": "#/$defs/WorkRef"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "title": "Profiles",
          "type": "array"
        },
        "priority": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "reading_depth": {
          "enum": [
            "abstract",
            "focused",
            "full",
            "technical"
          ],
          "title": "Reading Depth",
          "type": "string"
        },
        "sections_read": {
          "items": {
            "type": "string"
          },
          "title": "Sections Read",
          "type": "array"
        },
        "is_update_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Update Of"
        },
        "update_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Update Note"
        },
        "why_now": {
          "title": "Why Now",
          "type": "string"
        },
        "contribution": {
          "$ref": "#/$defs/Contribution"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "connection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Connection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "analysis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis"
        },
        "feedback_actions": {
          "items": {
            "$ref": "#/$defs/FeedbackAction"
          },
          "title": "Feedback Actions",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "work",
        "reading_depth",
        "why_now"
      ],
      "title": "ReportItem",
      "type": "object"
    },
    "RouteStatus": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "title": "Route",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "calls_today": {
          "default": 0,
          "title": "Calls Today",
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "route",
        "ok"
      ],
      "title": "RouteStatus",
      "type": "object"
    },
    "SourceStatus": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "empty",
            "failed",
            "partial",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        },
        "n_records": {
          "default": 0,
          "title": "N Records",
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source",
        "status"
      ],
      "title": "SourceStatus",
      "type": "object"
    },
    "Stats": {
      "additionalProperties": false,
      "properties": {
        "collected": {
          "default": 0,
          "title": "Collected",
          "type": "integer"
        },
        "new_works": {
          "default": 0,
          "title": "New Works",
          "type": "integer"
        },
        "candidates": {
          "default": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "screened": {
          "default": 0,
          "title": "Screened",
          "type": "integer"
        },
        "read": {
          "default": 0,
          "title": "Read",
          "type": "integer"
        },
        "analyzed": {
          "default": 0,
          "title": "Analyzed",
          "type": "integer"
        },
        "backlog": {
          "default": 0,
          "title": "Backlog",
          "type": "integer"
        }
      },
      "title": "Stats",
      "type": "object"
    },
    "Theme": {
      "additionalProperties": false,
      "description": "Weekly synthesis: a development connecting several works.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "work_ids": {
          "items": {
            "type": "string"
          },
          "title": "Work Ids",
          "type": "array"
        }
      },
      "required": [
        "title",
        "text"
      ],
      "title": "Theme",
      "type": "object"
    },
    "WorkRef": {
      "additionalProperties": false,
      "properties": {
        "work_id": {
          "title": "Work Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "preprint",
            "submitted",
            "accepted",
            "published",
            "withdrawn",
            "release",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "kind": {
          "default": "paper",
          "enum": [
            "paper",
            "release"
          ],
          "title": "Kind",
          "type": "string"
        },
        "released_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released Date"
        },
        "ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Ids",
          "type": "object"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        }
      },
      "required": [
        "work_id",
        "title"
      ],
      "title": "WorkRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "daily",
        "weekly",
        "deep"
      ],
      "title": "Kind",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "period_start": {
      "title": "Period Start",
      "type": "string"
    },
    "period_end": {
      "title": "Period End",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "quiet_day_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quiet Day Reason"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ReportItem"
      },
      "title": "Items",
      "type": "array"
    },
    "themes": {
      "items": {
        "$ref": "#/$defs/Theme"
      },
      "title": "Themes",
      "type": "array"
    },
    "also_noted": {
      "items": {
        "$ref": "#/$defs/WorkRef"
      },
      "title": "Also Noted",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceStatus"
      },
      "title": "Sources",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/BudgetSummary"
    },
    "stats": {
      "$ref": "#/$defs/Stats"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "kind",
    "title",
    "generated_at",
    "period_start",
    "period_end",
    "summary"
  ],
  "title": "Report",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamsikun/lark/docs/report-contract/v1.schema.json"
}
